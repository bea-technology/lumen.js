<!--
Source .view that render-hooks.hst.json was generated from, via fcs.js's
real parser (getAllFiles) — kept here so the fixture is reproducible and
reviewable, not just an opaque JSON blob. Regenerate with:

  node -e "
    const fcs = require('../../../cli/lib/fcs.js');
    const fs = require('fs');
    process.chdir(__dirname + '/test/fixtures');
    const files = fcs.getAllFiles(process.cwd() + '/', {}, false, true);
    const parsed = files[Object.keys(files).find(k => Buffer.from(k,'base64').toString().endsWith('render-hooks.view'))];
    fs.writeFileSync('render-hooks.hst.json', JSON.stringify(parsed.hst, null, 1));
  "

(getAllFiles expects a directory of .view files, not a single file path —
point it at this fixtures/ directory specifically, not the whole test/ tree.)
-->
<div class="carousel" id="e2e-carousel">
    <div class="cell" :for="images" @before-render="onBeforeRender" @after-render="onAfterRender">{{image}}</div>
</div>
<div id="e2e-if-wrap">
    <div :if="isAdmin" @before-render="onIfBeforeRender" @after-render="onIfAfterRender">Admin</div>
    <div :else @after-render="onElseAfterRender">Guest</div>
</div>
